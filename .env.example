# Jira Data Center
JIRA_BASE_URL=https://jira.example.com
JIRA_USERNAME=your.user
JIRA_PASSWORD=your-password-or-pat
# Optional: Bearer PAT instead of Basic (leave empty to use Basic)
JIRA_PAT=
JIRA_VERIFY_SSL=true
JIRA_TIMEOUT_SECONDS=60

# Default projects (comma-separated keys). Empty = ask in chat / pass via CLI.
JIRA_PROJECT_KEYS=PROJ,ITSM

# Insight / Assets object schema (default from your environment)
ASSETS_OBJECT_SCHEMA_ID=8

# ---------------------------------------------------------------------------
# LLM provider: ollama (local) | openai (any OpenAI-compatible cloud API)
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama

# --- Local Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=180

# --- Cloud OpenAI-compatible (used when LLM_PROVIDER=openai) ---
# OpenAI:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini
# OpenRouter:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=openai/gpt-4o-mini
# DeepSeek:
#   OPENAI_BASE_URL=https://api.deepseek.com
#   OPENAI_MODEL=deepseek-chat
# Groq:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_ORG_ID=
OPENAI_TIMEOUT_SECONDS=120

# Agent behaviour
AGENT_MAX_TOOL_ROUNDS=8
AGENT_MAX_ISSUES=50
AGENT_MAX_ASSETS=50
AGENT_LANGUAGE=ru
