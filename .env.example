# Jira Data Center
JIRA_BASE_URL=https://jira.example.com
JIRA_USERNAME=your.user
JIRA_PASSWORD=your-password-or-pat
# Optional: Bearer PAT instead of Basic (leave empty to use Basic)
JIRA_PAT=
JIRA_VERIFY_SSL=true
JIRA_TIMEOUT_SECONDS=60

# Default projects (comma-separated keys). Empty = ask in chat / pass via CLI.
JIRA_PROJECT_KEYS=PROJ,ITSM

# Insight / Assets object schema (default from your environment)
ASSETS_OBJECT_SCHEMA_ID=8

# ---------------------------------------------------------------------------
# LLM (только для CLI-чата jira-agent chat/ask).
# Для Cursor Agent + MCP ключ DeepSeek НЕ нужен.
# ---------------------------------------------------------------------------
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Aliases (optional; DEEPSEEK_API_KEY is preferred):
# OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
OPENAI_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.2
# IMPORTANT for corporate SSL inspection / self-signed MITM:
LLM_VERIFY_SSL=false
JIRA_VERIFY_SSL=false
# or better — path to corporate CA:
# LLM_CA_BUNDLE=C:\certs\corp-root-ca.pem

# --- Optional: local Ollama instead ---
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_NUM_CTX=8192
# OLLAMA_TIMEOUT_SECONDS=180

# Agent behaviour
AGENT_MAX_TOOL_ROUNDS=8
AGENT_MAX_ISSUES=50
AGENT_MAX_ASSETS=50
AGENT_LANGUAGE=ru
